<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xiaosheng.xiaoju.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/xiaocheng/workspace/openworker/.venv/bin/python</string>
        <string>/Users/xiaocheng/workspace/openworker/scripts/sync_daemon_runner.py</string>
        <string>--side</string>
        <string>mac</string>
        <string>--local-port</string>
        <string>18767</string>
        <string>--fwd-port</string>
        <string>18768</string>
        <string>--remote-port</string>
        <string>18767</string>
        <string>--db-path</string>
        <string>/Users/xiaocheng/.deskmate/deskmate.db</string>
        <string>--repo-path</string>
        <string>/Users/xiaocheng/workspace/openworker</string>
        <string>--ssh-host</string>
        <string>81.69.163.170</string>
        <string>--ssh-user</string>
        <string>ubuntu</string>
        <string>--identity-file</string>
        <string>/Users/xiaocheng/workspace/openworker/.workbuddy/server/aibbs.pem</string>
        <string>--log-path</string>
        <string>/Users/xiaocheng/.deskmate/sync_daemon.log</string>
        <!--
          日历型 tick（2026-10-07）：tick 只在 :02:04 跑，精确命中云端错峰同步窗口。
          背景：云端 sync daemon 仅每小时 :02 启动（xiaoju-sync-window.timer，窗口约
          54s），Mac 常驻 tick 在窗口外必被拒，指数退避封顶 240s 后与窗口互相错开 →
          实测 tick 落点 11:59:39 → 12:03:54 恰好跳过整窗口，两天零成功、push 水位冻结。

          注意：本进程仍需**常驻**（不是跑完即退）——云端窗口要push 到 Mac 的
          18767 oplog server（HttpOplogServer 收到即 apply），该 server 与 SSH 反隧道
          必须 24h 在线。日历型只改"tick 何时打"，server/隧道生命周期不变。
        -->
        <string>--window-calendar</string>
        <string>--window-slots</string>
        <string>02:04</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- 崩溃/异常退出自动重启；KeepAlive 自带节流，避免死循环刷屏 -->
    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- 网络未就绪时不强求立即起；网络起来后 KeepAlive 会拉起 -->
    <key>AbandonProcessGroup</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/Users/xiaocheng/.deskmate/sync_daemon.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/xiaocheng/workspace/openworker</string>
</dict>
</plist>
